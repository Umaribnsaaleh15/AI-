<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>index.html</title>
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #0b0b0b;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 24px;
  }
  .widget { width: 100%; max-width: 480px; }
  #status {
    color: #aaa;
    font-size: 13px;
    margin-bottom: 8px;
    min-height: 18px;
  }
  #progress-bar {
    height: 4px;
    background: #222;
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 10px;
    display: none;
  }
  #progress-fill {
    height: 100%;
    width: 0%;
    background: #0070f3;
    transition: width 0.2s;
  }
  #chat-log {
    display: flex;
    flex-direction: column;
    height: 460px;
    overflow-y: auto;
    padding: 16px;
    background: #111;
    border-radius: 12px;
    border: 1px solid #222;
  }
  .msg {
    margin: 8px 0;
    padding: 10px 14px;
    border-radius: 12px;
    max-width: 75%;
    word-wrap: break-word;
    color: white;
    white-space: pre-wrap;
    line-height: 1.4;
  }
  .msg.user { background: #0070f3; align-self: flex-end; }
  .msg.assistant { background: #2a2a2a; align-self: flex-start; }
  .msg.assistant.error { background: #4a1a1a; }
  .row { display: flex; gap: 8px; margin-top: 10px; }
  #chat-input {
    flex: 1;
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px solid #333;
    background: #1a1a1a;
    color: white;
    font-size: 14px;
  }
  #chat-input:focus { outline: 2px solid #0070f3; }
  #chat-input:disabled { opacity: 0.5; }
  #send-btn {
    padding: 10px 16px;
    border-radius: 8px;
    background: #0070f3;
    color: white;
    border: none;
    cursor: pointer;
    font-size: 14px;
  }
  #send-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  #send-btn:hover:not(:disabled) { background: #0059c1; }
</style>
</head>
<body>

<div class="widget">
  <div id="status">Checking your browser...</div>
  <div id="progress-bar"><div id="progress-fill"></div></div>
  <div id="chat-log"></div>
  <div class="row">
    <input id="chat-input" placeholder="Loading model..." autocomplete="off" disabled />
    <button id="send-btn" disabled>Send</button>
  </div>
</div>

<script type="module">
  import * as webllm from "https://esm.run/@mlc-ai/web-llm";

  const statusEl = document.getElementById("status");
  const progressBar = document.getElementById("progress-bar");
  const progressFill = document.getElementById("progress-fill");
  const input = document.getElementById("chat-input");
  const sendBtn = document.getElementById("send-btn");
  const log = document.getElementById("chat-log");

  const MODEL_ID = "Llama-3.2-3B-Instruct-q4f16_1-MLC";
  let engine = null;
  const messages = [];

  function appendMessage(role, text) {
    const el = document.createElement("div");
    el.className = "msg " + role;
    el.textContent = text;
    log.appendChild(el);
    log.scrollTop = log.scrollHeight;
    return el;
  }

  async function init() {
    if (!navigator.gpu) {
      statusEl.textContent = "Your browser doesn't support WebGPU. Try recent Chrome or Edge on desktop.";
      return;
    }

    statusEl.textContent = "Downloading model (first time only, cached after)...";
    progressBar.style.display = "block";

    try {
      engine = await webllm.CreateMLCEngine(MODEL_ID, {
        initProgressCallback: (report) => {
          const pct = Math.round((report.progress || 0) * 100);
          progressFill.style.width = pct + "%";
          statusEl.textContent = report.text || ("Loading... " + pct + "%");
        }
      });

      progressBar.style.display = "none";
      statusEl.textContent = "Ready — running fully offline in your browser.";
      input.disabled = false;
      sendBtn.disabled = false;
      input.placeholder = "Type a message...";
      input.focus();
    } catch (err) {
      statusEl.textContent = "Failed to load model: " + err.message;
    }
  }

  async function sendMessage() {
    const text = input.value.trim();
    if (!text || !engine) return;

    input.value = "";
    input.disabled = true;
    sendBtn.disabled = true;

    appendMessage("user", text);
    messages.push({ role: "user", content: text });

    const typingEl = appendMessage("assistant", "Thinking...");

    try {
      const reply = await engine.chat.completions.create({ messages });
      const text = reply.choices[0].message.content;
      messages.push({ role: "assistant", content: text });
      typingEl.textContent = text;
      typingEl.classList.remove("error");
    } catch (err) {
      typingEl.textContent = "Error: " + err.message;
      typingEl.classList.add("error");
      messages.pop();
    } finally {
      input.disabled = false;
      sendBtn.disabled = false;
      input.focus();
    }
  }

  sendBtn.addEventListener("click", sendMessage);
  input.addEventListener("keydown", (e) => {
    if (e.key === "Enter") sendMessage();
  });

  init();
</script>

</body>
</html>
